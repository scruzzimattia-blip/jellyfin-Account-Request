## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
dist/

# Visual Studio cache/options directory
.vs/

# Rider
.idea/

# Visual Studio Code
.vscode/

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.assets.json
artifacts/

# MSBuild binary and structured log
*.binlog

# Test results
TestResult*/
[Tt]est[Rr]esult*/
coverage/
coverage.xml
coverage.cobertura.xml

# OS-generated files
.DS_Store
Thumbs.db

# JetBrains dotCover
*.dotCover

# Local environment files
.env
.env.*
